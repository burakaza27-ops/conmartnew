# =============================================================================
# ConMart — Environment Template
# =============================================================================
# Copy to .env.local and fill in real values:
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real credentials — a database
# password in git history stays there until the password is rotated.
#
# These variables are validated at startup by src/lib/config/env.ts, so a
# missing or malformed value fails fast with a precise message instead of
# surfacing later as a zero-rated invoice.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Direct connection on port 5432. Used by `prisma db push`, `prisma migrate`,
# and `prisma db seed`, which need a session-level connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Transaction pooler on port 6543. Used by the app at runtime, because
# serverless functions open far more short-lived connections than Postgres can
# hold open directly. Optional: falls back to DATABASE_URL.
DATABASE_POOLER_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Supabase signs its certificates with a private CA, so verification only
# succeeds if you supply that certificate here. Download it from the Supabase
# dashboard under Project Settings > Database > SSL Configuration and paste the
# PEM contents as a single-line value with \n between lines.
DATABASE_CA_CERT=

# Disables certificate verification altogether. Development only — the app
# refuses to start with this enabled in production, because it would let anyone
# who can intercept the connection read every query, including the contact
# details behind the unlock paywall.
DATABASE_SSL_NO_VERIFY=false

# -----------------------------------------------------------------------------
# Supabase Auth (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Safe to expose to the browser: it grants nothing beyond what Row Level
# Security permits.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public URL for this deployment (REQUIRED in Vercel production).
# Password-reset emails always use this domain — not the *.vercel.app preview URL.
# Must match the domain users actually open in the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Supabase → Authentication → URL Configuration (add ALL of these):
#   Site URL: https://YOUR-DOMAIN
#   Redirect URLs:
#     http://localhost:3000/auth/callback
#     http://localhost:3000/auth/callback/recovery
#     http://localhost:3000/auth/confirm
#     https://YOUR-DOMAIN/auth/callback
#     https://YOUR-DOMAIN/auth/callback/recovery
#     https://YOUR-DOMAIN/auth/confirm

# Bypasses Row Level Security entirely. Server-only, and never prefixed with
# NEXT_PUBLIC. Used to delete an auth account whose profile write failed, so
# a half-created signup does not strand an unauthorizable account. Optional:
# without it those accounts are logged for manual cleanup instead.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for product images. Create it in the Supabase dashboard and
# make it public-read.
SUPABASE_STORAGE_BUCKET=products

# -----------------------------------------------------------------------------
# Commercial configuration
# -----------------------------------------------------------------------------
# Percentage added to a proforma subtotal. Zero under the contact-unlock model,
# where revenue comes from seller wallet introduction fees rather than a
# transaction cut.
PLATFORM_FEE_PERCENT=0

# Ethiopian standard VAT rate.
VAT_RATE_PERCENT=15

# Share of an unlock fee returned as non-withdrawable credit when a supplier
# reports that a deal collapsed after the introduction was paid for.
DEAL_FAILURE_REFUND_PERCENT=80

# -----------------------------------------------------------------------------
# Rate limiting (required in production)
# -----------------------------------------------------------------------------
# Without these, rate limits are counted per serverless instance and cannot
# enforce a global budget. Provision Upstash Redis from the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Content Security Policy
# -----------------------------------------------------------------------------
# Set to "true" to report violations without blocking. Use this when rolling
# out a policy change; leave unset to enforce.
CSP_REPORT_ONLY=

# -----------------------------------------------------------------------------
# Support contact shown in the UI
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_PHONE=+251 91 100 0000
NEXT_PUBLIC_ADMIN_WHATSAPP=251911000000
